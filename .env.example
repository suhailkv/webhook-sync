# MSSQL config
DB_USER=sa
DB_PASSWORD=yourStrong(!)Password
DB_SERVER=localhost
DB_DATABASE=YourDatabase
DB_TRUSTSERVERCERTIFICATE=true
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT_MS=30000

# Target table info (from your ESSL DB)
ESSL_TABLE=ESSL_BiometricLogs
ESSL_ID_COLUMN=id

# Polling / batching
POLL_INTERVAL_MS=5000
PAGE_SIZE=200         # how many rows to fetch per poll
BATCH_SIZE=50         # how many rows to send in one HTTP request (if API supports batch)
CONCURRENCY=4         # how many concurrent HTTP POSTs allowed

# API
API_URL=https://api.example.com/biometric/batch
API_AUTH_TOKEN=YOUR_TOKEN_IF_ANY
API_TIMEOUT_MS=15000

# Worker behavior
MAX_RETRIES=8
INITIAL_BACKOFF_MS=1000
STATE_DB=./state.db

# Logging
LOG_FILE=worker.log
LOG_LEVEL=info
