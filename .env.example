# Database type: mssql or mysql
DB_TYPE=mysql

# MSSQL settings (used if DB_TYPE=mssql)
MSSQL_SERVER=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong(!)Password
MSSQL_DATABASE=mydb

# MySQL settings (used if DB_TYPE=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=mydb

# Table & columns
SOURCE_TABLE=orders
PRIMARY_KEY_COLUMN=id   # must be monotonically increasing

# Destination API
DEST_API_URL=http://localhost:4000/ingest
API_AUTHORIZATION_HEADER=

# Sync behavior
POLL_INTERVAL_MS=5000
STATE_FILE=./state.json
BATCH_SIZE=200
MAX_RETRIES=5
LOG_FILE=./sync.log
